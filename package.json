{
  "name": "architect3d",
  "version": "1.0.0",
  "description": "This is the core framework of architect3d for creating floorplans in 2d and 3d",
  "type": "module",
  "main": "./src/scripts/blueprint.js",
  "exports": {
    ".": "./src/scripts/blueprint.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures": "node tools/make-fixtures.mjs",
    "parity": "node tools/capture-parity.mjs",
    "budget": "node tools/check-budget.mjs",
    "budget:update": "node tools/check-budget.mjs --update",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "types:emit": "tsc -p tsconfig.build.json",
    "prepare": "simple-git-hooks",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amitukind/architect3d.git"
  },
  "author": "#0K Amit Verma <amitverma.ukind@gmail.com> (@amitukind)",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "reka-ui": "^2.10.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "bezier-js": "^6.1.4",
    "three": "^0.185.1",
    "vue": "^3.5.41"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
