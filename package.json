{
  "name": "architect3d",
  "version": "2.0.0",
  "description": "This is the core framework of architect3d for creating floorplans in 2d and 3d",
  "type": "module",
  "main": "./dist/architect3d.js",
  "module": "./dist/architect3d.js",
  "types": "./dist/types/blueprint.d.ts",
  "unpkg": "./dist/bp3djs.js",
  "jsdelivr": "./dist/bp3djs.js",
  "exports": {
    ".": {
      "types": "./dist/types/blueprint.d.ts",
      "default": "./dist/architect3d.js"
    },
    "./iife": "./dist/bp3djs.js",
    "./source/*": "./src/scripts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/architect3d.js",
    "dist/architect3d.js.map",
    "dist/bp3djs.js",
    "dist/bp3djs.js.map",
    "dist/types",
    "src/scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:iife && npm run build:esm && npm run types:emit",
    "build:iife": "vite build --mode lib",
    "build:esm": "vite build --mode lib-esm",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "test:browser:watch": "vitest --config vitest.browser.config.mjs",
    "fixtures": "node tools/make-fixtures.mjs",
    "parity": "node tools/capture-parity.mjs",
    "manifest": "node tools/make-asset-manifest.mjs",
    "manifest:check": "node tools/make-asset-manifest.mjs --check",
    "encode": "node tools/encode-assets.mjs",
    "encode:check": "node tools/encode-assets.mjs --check",
    "resize": "node tools/resize-textures.mjs",
    "resize:check": "node tools/resize-textures.mjs --check",
    "budget": "node tools/check-budget.mjs",
    "budget:update": "node tools/check-budget.mjs --update",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "types:emit": "tsc -p tsconfig.build.json",
    "prepare": "simple-git-hooks",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amitukind/architect3d.git"
  },
  "author": "#0K Amit Verma <amitverma.ukind@gmail.com> (@amitukind)",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "axe-core": "^4.13.0",
    "bezier-js": "^6.1.4",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "reka-ui": "^2.10.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "bezier-js": "^6.1.4",
    "three": ">=0.185.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
